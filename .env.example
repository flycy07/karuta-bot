# Token del bot (Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=

# Opzionale: se impostato registra i comandi solo su questo server (aggiornamento immediato)
GUILD_ID=

# Opzionale: ID di un ruolo che può scegliere le carte del drop senza il permesso "Gestire il server"
ADMIN_ROLE_ID=

# Database SQLite (creato in automatico)
DATABASE_FILE=data/yomi.db

# Cooldown dopo un claim riuscito, in millisecondi
CLAIM_COOLDOWN_MS=20000

# Durata di un drop, in millisecondi
DROP_DURATION_MS=60000

# Cooldown tra due /drop dello stesso utente, in minuti (1-1440; fuori intervallo torna a 30)
# (il vecchio DROP_COOLDOWN_MS in millisecondi viene ignorato)
DROP_COOLDOWN_MINUTES=30

# Ogni quanto controllare i cooldown scaduti per avvisare l'utente in privato, in millisecondi
DROP_NOTIFY_INTERVAL_MS=30000
